---
import { getCollection } from "astro:content"; import { marked } from "marked"; import Layout from "../layouts/Layout.astro";
export async function getStaticPaths(){const a=await getCollection("articles");return a.map(p=>({params:{slug:p.data.slug},props:{article:p}}))}
const{article}=Astro.props;const{title,date,categories,categorySlugs,image,excerpt}=article.data;
const html=marked.parse(article.body||"");
---
<Layout title={title} description={excerpt} image={image}>
  <article class="article-single">
    {image&&<img src={image} alt={title} class="article-featured-image"/>}
    <h1>{title}</h1>
    <div class="article-meta"><time datetime={date}>{new Date(date).toLocaleDateString("en-US",{year:"numeric",month:"long",day:"numeric"})}</time>{categories.map((c:string,i:number)=><a href={`/category/${categorySlugs[i]}/`} class={`cat-tag cat-${categorySlugs[i]}`}>{c}</a>)}</div>
    <div class="article-body" set:html={html}/>
  </article>
</Layout>
