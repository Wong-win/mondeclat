---
import Header from "../components/Header.astro"; import Footer from "../components/Footer.astro"; import "../styles/global.css";
interface Props{title?:string;description?:string;image?:string} const{title,description,image}=Astro.props;
const st=title?`${title} — Mondeclat`:"Mondeclat — Style, Beauty, Living & Tech";
const sd=description||"Insightful stories on fashion, beauty, lifestyle, and technology — curate a more intentional everyday.";
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">    <link rel="canonical" href={new URL(Astro.url.pathname, `https://www.mondeclat.com`)} />
    <title>{st}</title><meta name="description" content={sd}><link rel="icon" type="image/svg+xml" href="/favicon.svg"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&display=swap" rel="stylesheet">{image&&<meta property="og:image" content={image}/>}<meta property="og:title" content={st}><meta property="og:description" content={sd}><meta property="og:type" content="website"><meta name="twitter:card" content="summary_large_image">


    <!-- Google tag (gtag.js) — GA4 (replace G-MONDECLAT0 with real ID) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-MONDECLAT0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-MONDECLAT0');
    </script>
  </head><body><div class="page-wrapper"><Header/><main class="container"><slot/></main><Footer/></div></body></html>